{
  "name": "al-mahasibpro-desktop-offline",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "build:win": "npm test && electron-builder --win nsis --x64 --publish never",
    "test:ui": "node tests/ui.smoke.mjs",
    "repair:accounts": "node tools/repair-accounting.mjs",
    "test:electron": "node tests/electron.smoke.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron-main.cjs",
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "iq.alarjwan.almahasib.desktop",
    "productName": "AlMahasibPro Offline",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.cjs",
      "server.mjs",
      "desktop-runtime.cjs",
      "accounting-schema.mjs",
      "stock.mjs",
      "stock-ui.js",
      "supplier-reports.mjs",
      "desktop-preload.cjs",
      "index.html",
      "package.json",
      "erp.mjs",
      "access.mjs",
      "erp-ui.js",
      "advanced.mjs",
      "currency.mjs",
      "scanner.mjs",
      "scanner-qrcode.js",
      "advanced-ui.js"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "AlMahasibPro-Offline-Setup-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3"
  }
}
